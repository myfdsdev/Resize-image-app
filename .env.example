# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Required for login (Auth.js) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# MongoDB Atlas connection string (free M0 cluster is enough)
MONGODB_URI=
MONGODB_DB=pixforge

# --- AI tools (users bring their own fal.ai key) ---
# Encrypts saved user API keys. Falls back to AUTH_SECRET if empty.
# Set it once and never change it, or saved keys can no longer be read.
KEY_ENCRYPTION_SECRET=

# --- Optional: "Continue with Google" ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Optional public settings (visible in the browser, never put secrets here) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAX_FILES=100
NEXT_PUBLIC_MAX_FILE_SIZE_MB=25
