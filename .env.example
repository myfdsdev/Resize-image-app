# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Required for login (Auth.js) ---
# Generate with: npx auth secret   (or any random 32+ character string)
AUTH_SECRET=

# MongoDB Atlas connection string (free M0 cluster is enough)
MONGODB_URI=
MONGODB_DB=pixforge

# --- Optional: "Continue with Google" ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Optional public settings (visible in the browser, never put secrets here) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAX_FILES=100
NEXT_PUBLIC_MAX_FILE_SIZE_MB=25
